# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Claude API model ids (see https://platform.claude.com/docs/en/models/overview)
RESEARCH_MODEL=claude-haiku-5-5
WRITER_MODEL=claude-haiku-5-5

# Optional tuning
# LLM_MAX_TOKENS=4096
# RESEARCH_MAX_STEPS=12
# RESEARCH_MAX_FETCHES_PER_SITE=2
# RESEARCH_PAGE_CHAR_LIMIT=12000
# SITEMAP_TTL_DAYS=7
