# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Claude API model ids (see https://platform.claude.com/docs/en/models/overview)
RESEARCH_MODEL=claude-haiku-5-5
WRITER_MODEL=claude-haiku-5-5

# Telegram delivery. Token from @BotFather. For the chat id: send /start to your bot,
# then run `uv run python -m english_agent.telegram chats`.
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=

# First day of the course (topic order 1). Without --topic the pipeline sends the topic of the day.
CURRICULUM_START_DATE=2026-10-27

# Learner's CEFR level (A2, B1, B2, C1) — picks which curriculum/<level>_topics.yaml is taught.
# Only the default for a new learner: a level picked in the bot (/level) is stored in the database and wins.
LEARNER_CEFR=A2

# PostgreSQL (docker compose service `postgres`). Generate the password with `openssl rand -hex 24`
# (hex keeps it URL-safe). Inside compose, DATABASE_URL is set to the `postgres` host automatically;
# the value here is for running commands on the host or on a laptop through `ssh -L 5432:localhost:5432 vpn`.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://english_agent:<POSTGRES_PASSWORD>@localhost:5432/english_agent

# When the server app (`python -m english_agent.app`) sends the daily lesson.
LESSON_SEND_TIME=09:00
TIMEZONE=Europe/Moscow

# Tracing (optional). Set to an OTLP/HTTP endpoint to export traces; leave unset to disable.
# For local Jaeger (`docker compose up -d`): http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional tuning
# LLM_MAX_TOKENS=4096
# RESEARCH_MAX_STEPS=12
# RESEARCH_MAX_FETCHES_PER_SITE=2
# RESEARCH_PAGE_CHAR_LIMIT=12000
# SITEMAP_TTL_DAYS=7
