# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Claude API model ids (see https://platform.claude.com/docs/en/models/overview)
RESEARCH_MODEL=claude-haiku-5-5
WRITER_MODEL=claude-haiku-5-5

# Telegram delivery. Token from @BotFather. Learners register themselves by sending /start.
# TELEGRAM_CHAT_ID is only the chat command-line runs act on (pipeline, telegram ping, storage set-schedule);
# to find yours: send /start to your bot, then run `uv run python -m english_agent.telegram chats`.
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=

# Only for `pipeline --no-send` previews without --topic: course day 1, to pick the topic of a date.
# CURRICULUM_START_DATE=2026-10-27

# Learner's CEFR level (A2, B1, B2, C1) — picks which curriculum/<level>_topics.yaml is taught.
# Only the default for a new learner: a level picked in the bot (/level) is stored in the database and wins.
LEARNER_CEFR=A2

# PostgreSQL (docker compose service `postgres`). Generate the password with `openssl rand -hex 24`
# (hex keeps it URL-safe). Inside compose, DATABASE_URL is set to the `postgres` host automatically;
# the value here is for running commands on the host or on a laptop through `ssh -L 5432:localhost:5432 vpn`.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://english_agent:<POSTGRES_PASSWORD>@localhost:5432/english_agent

# A new learner's schedule; each learner then changes their own with /time, /translation, /timezone.
LESSON_SEND_TIME=09:00
TIMEZONE=Europe/Moscow
# LESSON_CATCH_UP_HOURS=6
# Practice after the lesson (defaults shown; QUIZ_DELAY_MINUTES and TRANSLATION_SEND_TIME are per learner).
# QUIZ_DELAY_MINUTES=60
# TRANSLATION_SEND_TIME=18:00
# PRACTICE_GAP_MINUTES=60
# PRACTICE_CUTOFF_TIME=22:00
# GRADER_MODEL=claude-haiku-5-5
# GRADER_EFFORT=high

# Spaced repetition (FSRS, defaults shown): the recall probability reviews aim for, and the longest review gap.
# FSRS_DESIRED_RETENTION=0.9
# FSRS_MAXIMUM_INTERVAL_DAYS=180

# Tracing (optional). Set to an OTLP/HTTP endpoint to export traces; leave unset to disable.
# For local Jaeger (`docker compose up -d`): http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional tuning
# LLM_MAX_TOKENS=8192
# RESEARCH_MAX_STEPS=12
# RESEARCH_MAX_FETCHES_PER_SITE=2
# RESEARCH_PAGE_CHAR_LIMIT=12000
# SITEMAP_TTL_DAYS=7

# Logging: `json` on the server (one object per line, with chat/job/trace ids), `text` in a terminal.
# LOG_FORMAT=text
# LOG_LEVEL=INFO
# METRICS_PORT=0

# Claude API client (defaults shown).
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=4
# LLM_MAX_CONCURRENCY=3

# PostgreSQL pool per process (defaults shown).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# Redis: job queue, de-duplication keys, shared Telegram rate limit, sitemap cache.
# Inside compose it is set to the `redis` service automatically.
# REDIS_URL=redis://localhost:6379/0

# Telegram limits and delivery (defaults shown). ADMIN_CHAT_ID receives operational alerts.
# TELEGRAM_GLOBAL_RATE_PER_SECOND=25
# TELEGRAM_CHAT_RATE_PER_SECOND=1
# ADMIN_CHAT_ID=
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_PORT=8080

# Background jobs (defaults shown).
# JOB_MAX_ATTEMPTS=5
# LESSON_CLAIM_STALE_MINUTES=10
# CONTENT_GENERATION_STALE_MINUTES=20
